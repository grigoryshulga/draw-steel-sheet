data-kind":"trait","data-name":"Shield? Shield!","data-cost":"","data-language":"en"}}}}]],{"data":{"$":{"s":"ability-group","p":{"data-action":"passive","data-label":"Traits"}}}}]],{"data":{"$":{"s":"ability-groups"}}}]]]}},{"id":"monster.kobold.kobold-malice","kind":"monster-feature","name":"Раздор кобольдов","markdown":"В начале хода любого кобольда можно потратить [Раздор](#/codex/monsters.rule.monster.malice), чтобы активировать одну из следующих особенностей.\n\n> ⭐️ **Тактика манипулы (3 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> До 3 кобольдов совершают [свободный удар](#/catalog/glossary#term-glossary.free-strike), меняются местами с [соседним](#/catalog/glossary#term-glossary.adjacent) кобольдом, после чего тот кобольд совершает [свободный удар](#/catalog/glossary#term-glossary.free-strike).\n\n> 🌀 **Задать инициативу (5 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> Два кобольда совершают ходы подряд.\n\n> ⭐️ **Стена щитов (7 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> До конца раунда все кобольды с чертой «Щит? Щит!» накладывают дополнительную Помеху на направленные по ним Удары и Способности.\n","source":{"articleId":"monsters.monster.kobold.kobold-malice","path":"Monsters/monster/kobold/kobold-malice.md"},"originalId":"mcdm.monsters.v1/monster.kobold/kobold-malice","originalName":"Kobold Malice","originalDescription":"At the start of any kobolds's turn, you can spend [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice) to activate one of the following features.\n\n> ⭐️ **Maniple Tactics (3 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> Up to 3 kobolds make a [free strike](scc.v1:mcdm.heroes.v1/feature.common.main-actions/free-strike), swaps positions with an [adjacent](scc.v1:mcdm.heroes.v1/rule.combat/adjacent) kobold, and then that kobold makes a [free strike](scc.v1:mcdm.heroes.v1/feature.common.main-actions/free-strike).\n\n> 🌀 **Set the Initiative (5 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> Two kobolds take their turns in a row.\n\n> ⭐️ **Shield Wall (7 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> Until the end of the round, all kobolds with Shield? Shield! impose an additional bane on incoming strikes and abilities.","director":{"section":"monsters","sourcePath":"monster/kobold/kobold-malice.json","sourceRevision":"bdb12093b1d07bf8674453796eac907a09dd7dd3","groupSlug":"kobold","recordType":"featureblock"},"originalCoverage":{"status":"complete"},"printedCreature":{"ru":[0,[[2,["В начале хода любого кобольда можно потратить ",[5,["Раздор"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}],", чтобы активировать одну из следующих особенностей."]],[6,[[6,[[6,[[2,["Тактика манипулы"],{"data":{"$":{"s":"name"}}}],[2,["3 ",[5,["Раздора"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}]],{"data":{"$":{"s":"badge"}}}],[2,["До 3 кобольдов совершают ",[5,["свободный удар"],{"title":null,"url":"#/catalog/glossary#term-glossary.free-strike"}],", меняются местами с ",[5,["соседним"],{"title":null,"url":"#/catalog/glossary#term-glossary.adjacent"}]," кобольдом, после чего тот кобольд совершает ",[5,["свободный удар"],{"title":null,"url":"#/catalog/glossary#term-glossary.free-strike"}],"."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"none","data-kind":"malice","data-name":"Тактика манипулы","data-cost":"3 Раздора","data-language":"ru"}}}}],[6,[[2,["Задать инициативу"],{"data":{"$":{"s":"name"}}}],[2,["5 ",[5,["Раздора"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}]],{"data":{"$":{"s":"badge"}}}],[2,["Два кобольда совершают ходы подряд."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"none","data-kind":"malice","data-name":"Задать инициативу","data-cost":"5 Раздора","data-language":"ru"}}}}],[6,[[2,["Стена щитов"],{"data":{"$":{"s":"name"}}}],[2,["7 ",[5,["Раздо