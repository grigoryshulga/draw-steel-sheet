,"data-range":"17+"}}}}]],{"data":{"$":{"s":"tiers","p":{"data-language":"en"}}}}]],{"data":{"$":{"s":"card","p":{"data-action":"main","data-kind":"signature","data-name":"Bite","data-cost":"","data-language":"en"}}}}]],{"data":{"$":{"s":"ability-group","p":{"data-action":"main","data-label":"Main actions"}}}}],[6,[[6,[[2,["Sprint"],{"data":{"$":{"s":"name"}}}],[2,["1 ",[5,["Malice"],{"title":null,"url":"scc.v1:mcdm.monsters.v1/rule.monster/malice"}]],{"data":{"$":{"s":"badge"}}}],[6,[[2,[[3,[[5,["Maneuver"],{"title":null,"url":"scc.v1:mcdm.heroes.v1/rule.combat/turn"}]]]],{"data":{"$":{"s":"action"}}}],[2,[[3,["Self"]]],{"data":{"$":{"s":"distance"}}}],[2,[[3,["Self"]]],{"data":{"$":{"s":"target"}}}]],{"data":{"$":{"s":"facts","p":{"data-language":"en"}}}}],[2,[[3,["Effect:"]]," The worg moves up to their speed."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"maneuver","data-kind":"malice","data-name":"Sprint","data-cost":"1 Malice","data-language":"en"}}}}]],{"data":{"$":{"s":"ability-group","p":{"data-action":"maneuver","data-label":"Maneuvers"}}}}],[6,[[6,[[2,["Mounted Charger"],{"data":{"$":{"s":"name"}}}],[2,[],{"data":{"$":{"s":"badge"}}}],[2,["If a worg used as a mount charges, their rider gains an edge on melee strikes until the end of the rider's turn."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"passive","data-kind":"trait","data-name":"Mounted Charger","data-cost":"","data-language":"en"}}}}],[6,[[2,["Shared Craft"],{"data":{"$":{"s":"name"}}}],[2,[],{"data":{"$":{"s":"badge"}}}],[2,["If the worg's rider has the Crafty trait, the worg also has that trait."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"passive","data-kind":"trait","data-name":"Shared Craft","data-cost":"","data-language":"en"}}}}]],{"data":{"$":{"s":"ability-group","p":{"data-action":"passive","data-label":"Traits"}}}}]],{"data":{"$":{"s":"ability-groups"}}}]]]}},{"id":"monster.goblin.goblin-malice","kind":"monster-feature","name":"Раздор гоблинов","markdown":"В начале хода любого гоблина вы можете потратить [Раздор](#/codex/monsters.rule.monster.malice), чтобы активировать одну из следующих особенностей.\n\n> ⭐️ **Режим гоблина (3 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> Скорость каждого гоблина в столкновении увеличивается на +2 до конца раунда.\n\n> ❇️ **Мелкие уколы (5 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> Каждый враг в столкновении получает 1 урон за каждого гоблина, находящегося [смежно](#/catalog/glossary#term-glossary.adjacent) с ним.\n\n> 🌀 **Болотная вонь (7 [Раздора](#/codex/monsters.rule.monster.malice))**\n>\n> До конца раунда карту столкновения затягивает зелёный туман, который нельзя развеять ветром. Для всех негоблинов вся местность становится [труднопроходимой](#/catalog/glossary#term-glossary.difficult-terrain), и каждый негоблин на карте проходит **тест Мощи**.\n>\n> - **≤11:** 5 урона Ядом; существо [ослаблено](#/catalog/glossary#term-glossary.weakened), пока не рассеется туман.\n> - **12–16:** Существо [ослаблено](#/catalog/glossary#term-glossary.weakened), пока не рассеется туман.\n> - **17+:** Без эффекта.\n","source":{"articleId":"monsters.monster.goblin.goblin-malice","path":"Monsters/monster/goblin/goblin-malice.md"},"originalId":"mcdm.monsters.v1/monster.goblin/goblin-malice","originalName":"Goblin Malice","originalDescription":"At the start of any goblin's turn, you can spend [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice) to activate one of the following features.\n\n> ⭐️ **Goblin Mode (3 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> Each goblin in the encounter gains a +2 bonus to speed until the end of the round.\n\n> ❇️ **Tiny Stabs (5 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> Each enemy in the encounter takes 1 damage for each goblin [adjacent](scc.v1:mcdm.heroes.v1/rule.combat/adjacent) to them.\n\n> 🌀 **Swamp Stink (7 [Malice](scc.v1:mcdm.monsters.v1/rule.monster/malice))**\n>\n> The encounter map is covered in a green mist that lasts until the end of the round, and which can't be dispersed by wind. All areas of the map are [difficult terrain](scc.v1:mcdm.heroes.v1/movement/difficult-terrain) for non-goblins, and each non-goblin on the map makes a **Might test**.\n>\n> - **≤11:** 5 poison damage; the creature is [weakened](scc.v1:mcdm.heroes.v1/condition/weakened) until the mist disappears.\n> - **12-16:** The creature is [weakened](scc.v1:mcdm.heroes.v1/condition/weakened) until the mist disappears.\n> - **17+:** No effect.","director":{"section":"monsters","sourcePath":"monster/goblin/goblin-malice.json","sourceRevision":"bdb12093b1d07bf8674453796eac907a09dd7dd3","groupSlug":"goblin","recordType":"featureblock"},"originalCoverage":{"status":"complete"},"printedCreature":{"ru":[0,[[2,["В начале хода любого гоблина вы можете потратить ",[5,["Раздор"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}],", чтобы активировать одну из следующих особенностей."]],[6,[[6,[[6,[[2,["Режим гоблина"],{"data":{"$":{"s":"name"}}}],[2,["3 ",[5,["Раздора"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}]],{"data":{"$":{"s":"badge"}}}],[2,["Скорость каждого гоблина в столкновении увеличивается на +2 до конца раунда."],{"data":{"hProperties":{"className":["director-ability-prose"]}}}]],{"data":{"$":{"s":"card","p":{"data-action":"none","data-kind":"malice","data-name":"Режим гоблина","data-cost":"3 Раздора","data-language":"ru"}}}}],[6,[[2,["Мелкие уколы"],{"data":{"$":{"s":"name"}}}],[2,["5 ",[5,["Раздора"],{"title":null,"url":"#/codex/monsters.rule.monster.malice"}]],{"data":{"$":{"s":"badge"}}}],[2,["Каждый враг в столкновении получает 1 урон за каждого гоблина, находящегося ",[5,["смежно"],{"title":null,"url":"#/catalog/glossary#term-glossary.adjacent"}]," с ним."],{"data":{"hProperties":{